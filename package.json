    "format": "oxfmt --write \"**/*.ts\""
  },
  "dependencies": {
    "human-id": "^4.2.1",
    "uhtml": "^5.0.9"
  },
  "devDependencies": {
    "@bluwy/usb": "^0.2.0",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.66.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
