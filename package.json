{
  "name": "github-changesets-userscript",
  "private": true,
  "version": "0.3.2",
  "author": "Bjorn Lu",
  "license": "MIT",
  "description": "Improve the Changesets experience in GitHub PRs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluwy/github-changesets-userscript.git"
  },
  "bugs": {
